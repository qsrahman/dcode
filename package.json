{
  "name": "dcode",
  "version": "0.15.2",
  "description": "A CLI-based AI coding agent built on the OpenAI Responses SDK.",
  "type": "module",
  "bin": {
    "dcode": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "author": "Qazi Sami ur Rahman <qsrahmans@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "stress": "node scripts/live-stress.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@vscode/ripgrep": "^1.18.0",
    "execa": "^10.0.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "node-html-markdown": "^2.0.0",
    "openai": "^7.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
