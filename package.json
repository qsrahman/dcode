{
  "name": "dcode",
  "version": "0.13.0",
  "description": "A CLI-based AI coding agent built on the OpenAI Responses SDK.",
  "type": "module",
  "bin": {
    "dcode": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "author": "Qazi Sami ur Rahman <qsrahmans@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "stress": "node --env-file-if-exists=.env scripts/live-stress.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
